.DS_Store
*.log

# AI agent configuration at the repo root.
#
# The MXCLI installer (dist/install.sh) generates these itself. Keeping them
# untracked means git never overwrites what the installer wrote, and local
# agent tweaks never end up in a commit. The canonical sources live under
# dist/ and stay tracked - every pattern below is anchored to the repo root
# with a leading slash so nothing inside dist/ is affected.

# Claude Code
/CLAUDE.md
/CLAUDE.local.md
/.claude/

# OpenAI Codex / general agent instructions
/AGENTS.md
/.codex/

# Cursor
/.cursor/
/.cursorrules

# Other assistants
/GEMINI.md
/.gemini/
/.windsurfrules
/.aider*
/.github/copilot-instructions.md

# MCP server config (may carry local endpoints or tokens)
/.mcp.json
